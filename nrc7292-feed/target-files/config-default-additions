# Enable I2C (PMIC on I2C2)
CONFIG_I2C=y
CONFIG_I2C_IMX=y

# Enable SPI master (ecspi4 for NRC7292)
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_IMX=y

# Enable watchdog (for proper reboot)
CONFIG_WATCHDOG=y
CONFIG_IMX2_WDT=y


# Enable MFD/regulator (PFUZE3001 PMIC)
CONFIG_MFD_SYSCON=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_PFUZE100=y

# Modularize - loaded from rootfs at runtime
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NFT_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_IPTABLES=m

# Crypto - keep only essentials built-in, rest as modules
# CONFIG_CRYPTO_USER is not set
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_DEFLATE=m
CONFIG_CRYPTO_LZO=m
CONFIG_CRYPTO_ZSTD=m
CONFIG_CRYPTO_ECHAINIV=m
CONFIG_CRYPTO_CBC=m
CONFIG_CRYPTO_CTR=m
CONFIG_CRYPTO_HMAC=m
CONFIG_CRYPTO_SHA512=m
CONFIG_CRYPTO_GCM=m

# Keep built-in (needed for boot)
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI_FSL_QUADSPI=y
CONFIG_SQUASHFS=y
CONFIG_FEC=y
CONFIG_IPV6=y
CONFIG_NET=y

# Disable debug info (saves ~1MB+ in kernel image)
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set

# Move these to modules

# Use XZ compression for smaller kernel image
