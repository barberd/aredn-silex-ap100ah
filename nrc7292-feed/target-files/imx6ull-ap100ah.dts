/*
 * Device Tree Source for Silex AP-100AH
 *
 * SoC: NXP i.MX6ULL
 * RAM: 128 MB DDR3
 * Flash: 32 MB QSPI NOR (Spansion S25FL256S1)
 * Ethernet: FEC with RMII PHY
 * WiFi: NRC7292 via SDIO (USDHC1)
 * Console: UART1 (ttymxc0) @ 115200
 *
 * Copyright (C) 2024 OpenWrt.org
 */

/dts-v1/;

#include "imx6ull.dtsi"

/ {
	model = "Silex AP-100AH";
	compatible = "silex,ap-100ah", "fsl,imx6ull";

	chosen {
		stdout-path = &uart1;
		bootargs = "console=ttymxc0,115200 root=/dev/mtdblock5 rootwait ro rootfstype=squashfs";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x08000000>; /* 128 MB */
	};

	reg_vsd_3v3: regulator-vsd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VSD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	leds {
		compatible = "gpio-leds";

		led-power {
			label = "orange:power";
			gpios = <&gpio4 24 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-wifi {
			label = "yellow:wifi";
			gpios = <&gpio1 26 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-lan {
			label = "green:lan";
			gpios = <&gpio4 23 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
};

&iomuxc {
	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO02__UART1_DCE_TX	0x1b0b1
			MX6UL_PAD_GPIO1_IO03__UART1_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_enet1: enet1grp {
		fsl,pins = <
			MX6UL_PAD_ENET1_RX_EN__ENET1_RX_EN	0x1b0b0
			MX6UL_PAD_ENET1_RX_ER__ENET1_RX_ER	0x1b0b0
			MX6UL_PAD_ENET1_RX_DATA0__ENET1_RDATA00	0x1b0b0
			MX6UL_PAD_ENET1_RX_DATA1__ENET1_RDATA01	0x1b0b0
			MX6UL_PAD_ENET1_TX_EN__ENET1_TX_EN	0x1b0b0
			MX6UL_PAD_ENET1_TX_DATA0__ENET1_TDATA00	0x1b0b0
			MX6UL_PAD_ENET1_TX_DATA1__ENET1_TDATA01	0x1b0b0
			MX6UL_PAD_ENET1_TX_CLK__ENET1_REF_CLK1	0x4001b031
		>;
	};

	pinctrl_enet1_mdio: enet1mdiogrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO07__ENET1_MDC		0x1b0b0
			MX6UL_PAD_GPIO1_IO06__ENET1_MDIO	0x1b0b0
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CMD__USDHC1_CMD		0x17059
			MX6UL_PAD_SD1_CLK__USDHC1_CLK		0x10071
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0	0x17059
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1	0x17059
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2	0x17059
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3	0x17059
		>;
	};

	pinctrl_qspi: qspigrp {
		fsl,pins = <
			MX6UL_PAD_NAND_WP_B__QSPI_A_SCLK	0x70a1
			MX6UL_PAD_NAND_READY_B__QSPI_A_DATA00	0x70a1
			MX6UL_PAD_NAND_CE0_B__QSPI_A_DATA01	0x70a1
			MX6UL_PAD_NAND_CE1_B__QSPI_A_DATA02	0x70a1
			MX6UL_PAD_NAND_CLE__QSPI_A_DATA03	0x70a1
			MX6UL_PAD_NAND_DQS__QSPI_A_SS0_B	0x70a1
		>;
	};

	pinctrl_ecspi4: ecspi4grp {
		fsl,pins = <
			MX6UL_PAD_ENET2_TX_DATA1__ECSPI4_SCLK	0x1090
			MX6UL_PAD_ENET2_TX_EN__ECSPI4_MOSI	0x1090
			MX6UL_PAD_ENET2_TX_CLK__ECSPI4_MISO	0x1090
			MX6UL_PAD_ENET2_RX_ER__GPIO2_IO15	0x1090
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6UL_PAD_UART5_TX_DATA__I2C2_SCL	0x4001b8b0
			MX6UL_PAD_UART5_RX_DATA__I2C2_SDA	0x4001b8b0
		>;
	};

	pinctrl_nrc_irq: nrcirqgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO01__GPIO1_IO01	0x17059
		>;
	};
};

/* Console UART */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/* Ethernet (FEC1 @ 0x02188000) */
&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet1 &pinctrl_enet1_mdio>;
	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	phy-reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <1>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
			smsc,disable-energy-detect;
		};
	};
};

/* NRC7292 WiFi on SPI (ecspi4, bus 3) */
&ecspi4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi4 &pinctrl_nrc_irq>;
	fsl,spi-num-chipselects = <1>;
	cs-gpios = <&gpio2 15 GPIO_ACTIVE_HIGH>;
	status = "okay";

	nrc7292: wifi@0 {
		compatible = "nrc80211";
		spi-max-frequency = <16000000>;
		reg = <0>;
		interrupt-parent = <&gpio1>;
		interrupts = <1 IRQ_TYPE_LEVEL_HIGH>;
	};
};

/* USDHC1 */
&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <4>;
	non-removable;
	status = "okay";
};

/* QSPI NOR Flash */
&qspi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_qspi>;
	status = "okay";

	flash0: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "env";
				reg = <0x40000 0x10000>;
			};

			partition@50000 {
				label = "fdt";
				reg = <0x50000 0x10000>;
			};

			partition@60000 {
				label = "kernel";
				reg = <0x60000 0x300000>;
			};

			partition@360000 {
				label = "data";
				reg = <0x360000 0x100000>;
			};

			partition@460000 {
				label = "rootfs";
				reg = <0x460000 0x1BA0000>;
			};
		};
	};
};

/* I2C2 - PFUZE3001 PMIC */
&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	clock-frequency = <100000>;
	status = "okay";
};

/* USB OTG1 - host mode */
&usbotg1 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

/* USB OTG2 - host mode */
&usbotg2 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

/* Watchdog for proper reboot */
&wdog1 {
	status = "okay";
};

/* Disable unused */
&fec2 {
	status = "disabled";
};
