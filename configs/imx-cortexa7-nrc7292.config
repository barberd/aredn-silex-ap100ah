CONFIG_TARGET_imx=y
CONFIG_TARGET_imx_cortexa7=y
CONFIG_TARGET_imx_cortexa7_Default=y
#
# NRC7292 packages
#
CONFIG_PACKAGE_kmod-nrc7292=y
CONFIG_PACKAGE_nrc7292-firmware=y
CONFIG_PACKAGE_nrc7292-init=y
CONFIG_PACKAGE_nrc7292-cli-app=y
#
# WiFi (stock hostapd/wpa_supplicant - NOT s1g forks)
#
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_MAC80211_MESH=y
CONFIG_PACKAGE_MAC80211_DEBUGFS=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-regdb=y
#
# Hardware support
#
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-usb-common=y
CONFIG_PACKAGE_kmod-usb-core=y
#
# Kernel optimizations for AP-100AH (128MB RAM, 32MB NOR flash)
#
# CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_SWAP is not set
# CONFIG_KERNEL_AIO is not set
# CONFIG_KERNEL_CGROUPS is not set
# CONFIG_KERNEL_CRASH_DUMP is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_KERNEL_IP_MROUTE is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MPTCP is not set
# CONFIG_KERNEL_NAMESPACES is not set
# CONFIG_KERNEL_NET_L3_MASTER_DEV is not set
CONFIG_KERNEL_DEVTMPFS=y
CONFIG_KERNEL_DEVTMPFS_MOUNT=y
#
# Disable u-boot package (we use existing u-boot on the device)
#
# CONFIG_PACKAGE_u-boot-pico-pi-imx7d is not set
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_kmod-8021q=y
